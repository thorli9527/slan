#!/bin/sh
set -eu

LABEL="dev.slan.client-core-service"
APP_LABEL="dev.slan.client-v2"
INSTALL_DIR="/Library/Application Support/SLAN"
STATE_ROOT="/Library/Preferences/dev.slan.client-core-service"
STATE_DIR="${STATE_ROOT}/SLAN"
STATE_BACKUP="/private/var/tmp/dev.slan.client-core-service.config.backup"
LOG_DIR="/Library/Logs/SLAN"
PLIST="/Library/LaunchDaemons/${LABEL}.plist"
APP_PLIST="/Library/LaunchAgents/${APP_LABEL}.plist"
APP_PATH="/Applications/SLAN Client V2.app"
APP_BIN="${APP_PATH}/Contents/MacOS/slan_client_v2"
SERVICE_BIN="${INSTALL_DIR}/client-core-service"
INSTALL_LOG="${LOG_DIR}/installer.log"
SERVICE_PID="${INSTALL_DIR}/client-core-service.pid"

mkdir -p "$INSTALL_DIR" "$LOG_DIR" "$STATE_DIR"
chown root:wheel "$INSTALL_DIR" "$LOG_DIR"
chmod 755 "$INSTALL_DIR" "$LOG_DIR"
chown -R root:wheel "$STATE_ROOT"
chmod 700 "$STATE_ROOT" "$STATE_DIR"

if [ ! -f "${STATE_DIR}/config.json" ]; then
  if [ -f "$STATE_BACKUP" ]; then
    cp -p "$STATE_BACKUP" "${STATE_DIR}/config.json"
  elif [ -f "${INSTALL_DIR}/config.json" ]; then
    cp -p "${INSTALL_DIR}/config.json" "${STATE_DIR}/config.json"
  fi
fi
if [ -f "${STATE_DIR}/config.json" ]; then
  chown root:wheel "${STATE_DIR}/config.json"
  chmod 600 "${STATE_DIR}/config.json"
fi
rm -f "$STATE_BACKUP"

launchctl bootout "system/${LABEL}" >/dev/null 2>&1 || true
launchctl disable "system/${LABEL}" >/dev/null 2>&1 || true
if [ -f "$APP_PLIST" ]; then
  CONSOLE_UID="$(stat -f '%u' /dev/console 2>/dev/null || echo "")"
  if [ -n "$CONSOLE_UID" ] && [ "$CONSOLE_UID" != "0" ]; then
    launchctl bootout "gui/${CONSOLE_UID}/${APP_LABEL}" >/dev/null 2>&1 || true
    launchctl disable "gui/${CONSOLE_UID}/${APP_LABEL}" >/dev/null 2>&1 || true
  fi
fi
pkill -x "slan_client_v2" >/dev/null 2>&1 || true
pkill -x "client-core-service" >/dev/null 2>&1 || true
rm -f "$SERVICE_PID"

if [ ! -x "$SERVICE_BIN" ]; then
  echo "missing service binary: $SERVICE_BIN" >&2
  exit 1
fi
if [ ! -x "$APP_BIN" ]; then
  echo "missing app binary: $APP_BIN" >&2
  exit 1
fi

chown root:wheel "$SERVICE_BIN"
chmod 755 "$SERVICE_BIN"
chown -R root:wheel "$APP_PATH"

DEVICE_ID="$(SLAN_STATE_DIR="$STATE_ROOT" "$SERVICE_BIN" --ensure-device-id)"
{
  echo "installedAt: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "deviceId: $DEVICE_ID"
  echo "serviceInfo: $(SLAN_STATE_DIR="$STATE_ROOT" "$SERVICE_BIN" --service-info)"
} >>"$INSTALL_LOG"
chown root:wheel "$INSTALL_LOG"
chmod 644 "$INSTALL_LOG"

cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${SERVICE_BIN}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>WorkingDirectory</key>
  <string>${INSTALL_DIR}</string>
  <key>StandardOutPath</key>
  <string>${LOG_DIR}/client-core-service.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>${LOG_DIR}/client-core-service.stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SLAN_CLIENT_CORE_SERVICE_HOST</key>
    <string>127.0.0.1:46392</string>
    <key>SLAN_STATE_DIR</key>
    <string>${STATE_ROOT}</string>
  </dict>
</dict>
</plist>
PLIST

chown root:wheel "$PLIST"
chmod 644 "$PLIST"

cat > "$APP_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${APP_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${APP_BIN}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>WorkingDirectory</key>
  <string>${APP_PATH}/Contents/MacOS</string>
  <key>StandardOutPath</key>
  <string>${LOG_DIR}/slan-client-v2.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>${LOG_DIR}/slan-client-v2.stderr.log</string>
</dict>
</plist>
PLIST

chown root:wheel "$APP_PLIST"
chmod 644 "$APP_PLIST"

launchctl enable "system/${LABEL}" >/dev/null 2>&1 || true
launchctl bootstrap system "$PLIST"
launchctl kickstart -k "system/${LABEL}"

CONSOLE_UID="$(stat -f '%u' /dev/console 2>/dev/null || echo "")"
if [ -n "$CONSOLE_UID" ] && [ "$CONSOLE_UID" != "0" ]; then
  launchctl bootout "gui/${CONSOLE_UID}/${APP_LABEL}" >/dev/null 2>&1 || true
  launchctl enable "gui/${CONSOLE_UID}/${APP_LABEL}" >/dev/null 2>&1 || true
  launchctl bootstrap "gui/${CONSOLE_UID}" "$APP_PLIST" >/dev/null 2>&1 || true
  launchctl kickstart -k "gui/${CONSOLE_UID}/${APP_LABEL}" >/dev/null 2>&1 || true
fi

exit 0
