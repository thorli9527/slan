#!/bin/sh
set -eu

SERVICE_LABEL="dev.slan.client-core-service"
APP_LABEL="dev.slan.client-v2"

launchctl bootout "system/${SERVICE_LABEL}" >/dev/null 2>&1 || true
if [ -f "/Library/LaunchAgents/${APP_LABEL}.plist" ]; then
  CONSOLE_UID="$(stat -f '%u' /dev/console 2>/dev/null || echo "")"
  if [ -n "$CONSOLE_UID" ] && [ "$CONSOLE_UID" != "0" ]; then
    launchctl bootout "gui/${CONSOLE_UID}/${APP_LABEL}" >/dev/null 2>&1 || true
  fi
fi
pkill -x "slan_client_v2" >/dev/null 2>&1 || true

exit 0
