POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_BIND_HOST=0.0.0.0
POSTGRES_PUBLIC_PORT=15432
REDIS_BIND_HOST=127.0.0.1
REDIS_PUBLIC_PORT=16379
SLAN_OPS_ACCESS_TOKEN=change-me-ops-token
SLAN_OPS_DEFAULT_ADMIN_PASSWORD=admin
# Local Docker + Caddy defaults.
# For LAN testing, replace these with your host IP and preferred scheme.
SLAN_HTTP_PUBLIC_HOST=slan.localhost:18443
SLAN_HTTP_PUBLIC_SCHEME=https
SLAN_BIZ_PUBLIC_PORT=28080
SLAN_BIZ_OPS_PORT=28081
SLAN_WEB_PORT=24200

# Local wire control/data plane.
SLAN_INTERNAL_WIRE_TOKEN=change-me-wire-internal-token
SLAN_WIRE_NODE_HEARTBEAT_FRESHNESS_SECONDS=120
SLAN_WIRE_NODE_CLEANUP_INTERVAL_SECONDS=60
SLAN_WIRE_NODE_EVENT_RETENTION_SECONDS=604800
SLAN_WIRE_TICKET_SECRET=change-me-wire-ticket-secret
SLAN_WIRE_TICKET_SECRETS=change-me-wire-ticket-secret
SLAN_WIRE_POSTGRES_DSN=postgres://postgres:change-me-postgres-password@postgres:5432/slan?sslmode=disable
SLAN_WIRE_PORT=29100
SLAN_WIRE_B_PORT=29101
SLAN_WIRE_RELAY_PORT=29110
SLAN_WIRE_RELAY_ADMIN_PORT=29111
SLAN_WIRE_RELAY_REGION_ID=local
SLAN_WIRE_RELAY_NODE_ID=relay-local
SLAN_WIRE_RELAY_PUBLIC_HOST=127.0.0.1
SLAN_WIRE_RELAY_B_REGION_ID=local
SLAN_WIRE_RELAY_B_NODE_ID=relay-local-b
SLAN_WIRE_RELAY_B_PUBLIC_HOST=127.0.0.1
SLAN_WIRE_RELAY_B_PUBLIC_UDP_PORT=29110
SLAN_WIRE_RELAY_B_ADMIN_PORT=29113
SLAN_WIRE_DERP_PORT=29120
SLAN_WIRE_DERP_ADMIN_PORT=29121
SLAN_WIRE_DERP_REGION_ID=local
SLAN_WIRE_DERP_NODE_ID=derp-local
SLAN_WIRE_DERP_PUBLIC_HOST=127.0.0.1
SLAN_WIRE_DERP_PUBLIC_PORT=443
SLAN_WIRE_DERP_B_REGION_ID=local
SLAN_WIRE_DERP_B_NODE_ID=derp-local-b
SLAN_WIRE_DERP_B_PUBLIC_HOST=127.0.0.1
SLAN_WIRE_DERP_B_PUBLIC_PORT=443
SLAN_WIRE_DERP_B_ADMIN_PORT=29123

# Local MQTT over BifroMQ. MQTT is required for the control channel.
SLAN_MQTT_ENABLED=true
SLAN_MQTT_BROKER_URL=mqtt://bifromq:1883
SLAN_MQTT_PUBLIC_BROKER_URL=mqtt://127.0.0.1:1883
SLAN_MQTT_PASSWORD_SECRET=change-me-mqtt-secret
BIFROMQ_MQTT_PORT=1883
BIFROMQ_AUTH_PROVIDER_URL=http://server-biz:8080/mqtt/bifromq
BIFROMQ_VERSION=4.0.0-incubating
BIFROMQ_MEM_LIMIT=2g
BIFROMQ_MEM_LIMIT_BYTES=2147483648
