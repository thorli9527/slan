POSTGRES_PASSWORD=change-me-postgres-password
SLAN_OPS_ACCESS_TOKEN=change-me-ops-token
SLAN_OPS_DEFAULT_ADMIN_PASSWORD=change-me-admin-password
SLAN_RELAY_TICKET_SIGNING_SECRET=change-me-relay-ticket-secret
