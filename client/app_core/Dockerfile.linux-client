FROM rust:1-bookworm AS builder

WORKDIR /src/client/app_core

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY scripts ./scripts

RUN cargo build --release -p app-core-cli -p app-core-helper -p app-core-service

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        iproute2 \
        wireguard-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /src/client/app_core/target/release/app-core-cli /app/app-core-cli
COPY --from=builder /src/client/app_core/target/release/app-core-helper /app/app-core-helper
COPY --from=builder /src/client/app_core/target/release/app-core-service /app/app-core-service
COPY --from=builder /src/client/app_core/scripts /app/scripts

ENV SLAN_TUNNEL_DRIVER=linux-kernel
ENV SLAN_LINUX_EXECUTOR=shell
ENV SLAN_APP_CORE_HELPER_LOG=/var/log/slan/app-core-helper.log
ENV SLAN_CONTROL_BASE_URL=http://host.docker.internal:28080

ENTRYPOINT ["/app/app-core-cli"]
CMD ["--help"]
