#!/usr/bin/env sh
set -eu

if [ -n "${SLAN_LINUX_INSTALL_LIB:-}" ] && [ -f "$SLAN_LINUX_INSTALL_LIB" ]; then
  . "$SLAN_LINUX_INSTALL_LIB"
elif [ -f "/opt/slan-client-v2/lib/slan-linux-install.sh" ]; then
  . "/opt/slan-client-v2/lib/slan-linux-install.sh"
else
  script_dir="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
  . "$script_dir/lib/slan-linux-install.sh"
fi

service_bin="${SLAN_CLIENT_CORE_SERVICE_BIN:-$SLAN_LINUX_SERVICE_BIN}"
config_dir="$SLAN_LINUX_CONFIG_DIR"
env_file="$config_dir/$SLAN_LINUX_CONSOLE_ENV_NAME"
server_url="${SLAN_CONTROL_BASE_URL:-}"
authorization_key=""
enable_network="false"
foreground="false"

usage() {
  cat <<'EOF'
Usage: slan-client-v2-console [--server-url URL] [--authorization-key KEY] [options]

Missing --server-url / --authorization-key values are prompted interactively
when a terminal is attached.

Options:
  --server-url URL         Server control base URL.
  --server URL             Alias for --server-url.
  --authorization-key KEY  Opt-issued device authorization Key.
  --enable-network       Enable network after bootstrap is consumed by core-service.
  --foreground           Run client-core-service in this console.
  -h, --help             Show this help.
EOF
}

need_value() {
  if [ "$#" -lt 2 ] || [ -z "$2" ]; then
    echo "Missing value for $1" >&2
    exit 2
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --server-url|--server)
      need_value "$@"
      server_url="$2"
      shift 2
      ;;
    --server-url=*|--server=*)
      server_url="${1#--server-url=}"
      server_url="${server_url#--server=}"
      shift
      ;;
    --authorization-key)
      need_value "$@"
      authorization_key="$2"
      shift 2
      ;;
    --authorization-key=*)
      authorization_key="${1#--authorization-key=}"
      shift
      ;;
    --enable-network)
      enable_network="true"
      shift
      ;;
    --foreground)
      foreground="true"
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [ -z "$server_url" ] && [ -t 0 ]; then
  printf 'Server API URL (e.g. http://192.168.5.102:28080): '
  IFS= read -r server_url || server_url=""
  server_url="$(printf '%s' "$server_url" | tr -d '\r')"
fi
if [ -z "$authorization_key" ] && [ -t 0 ]; then
  printf 'Device authorization key (input hidden): '
  stty -echo 2>/dev/null || true
  IFS= read -r authorization_key || authorization_key=""
  stty echo 2>/dev/null || true
  printf '\n'
  authorization_key="$(printf '%s' "$authorization_key" | tr -d '\r')"
fi

case "$server_url" in
  http://*|https://*)
    ;;
  *)
    echo "--server-url must be an http:// or https:// URL" >&2
    exit 2
    ;;
esac
case "$server_url" in
  *[[:space:]]*)
    echo "--server-url must not contain whitespace" >&2
    exit 2
    ;;
esac
server_url="${server_url%/}"

if [ -z "$authorization_key" ]; then
  echo "--authorization-key is required" >&2
  exit 2
fi
case "$authorization_key" in
  *[[:space:]]*)
    echo "--authorization-key must not contain whitespace" >&2
    exit 2
    ;;
esac

umask 077
mkdir -p "$config_dir"
tmp_file="$env_file.tmp"
{
  printf 'SLAN_CONTROL_BASE_URL=%s\n' "$server_url"
  printf 'SLAN_DEVICE_AUTHORIZATION_KEY=%s\n' "$authorization_key"
  printf 'SLAN_PENDING_ENABLE_NETWORK=%s\n' "$enable_network"
} > "$tmp_file"
mv "$tmp_file" "$env_file"

if [ "$foreground" = "true" ]; then
  exec "$service_bin"
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl restart "$SLAN_LINUX_SERVICE_NAME"
  systemctl status --no-pager "$SLAN_LINUX_SERVICE_NAME" || true
else
  echo "Wrote $env_file. Start $service_bin manually or run with --foreground."
fi
